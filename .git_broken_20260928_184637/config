[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://gitee.com/rod-detection/speeding-capture-ui.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
[branch "dev/rtsp"]
	remote = github
	merge = refs/heads/main
[remote "github"]
	url = https://github.com/Felosefe/speeding-capture-ui.git
	fetch = +refs/heads/*:refs/remotes/github/*
